{
  "manifest_version": 3,
  "name": "Auren Price Calculator",
  "short_name": "Auren",
  "version": "1.0.0",
  "description": "Calculadora profissional de precificação para Dropshipping: preço ideal, margem, ROI, ROAS e CPA em tempo real.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Auren Price Calculator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
